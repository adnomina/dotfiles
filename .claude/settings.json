{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PowerShell",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "guardrails@peerigon-claude-plugins": true,
    "gitkraken-hooks@gitkraken": true
  },
  "extraKnownMarketplaces": {
    "peerigon-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "peerigon/claude-plugins"
      }
    },
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "/Users/nicolas/.claude/plugins/marketplaces/gitkraken"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "theme": "dark"
}
